# Compose loads this file. Native Python runs require exporting these values.
SECRET_KEY=replace-with-at-least-50-random-characters
DEBUG=true
# Native loopback-only development login, opt-in. Must be false for production.
DEV_LOGIN_ENABLED=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=journal
POSTGRES_USER=journal
POSTGRES_PASSWORD=replace-with-a-strong-unique-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CHILD_NAME=Alex
TRUST_PROXY=false
ENABLE_HSTS=false
